{
  // IMPORTANTE: se conectar a um Worker existente, este nome precisa
  // ser idêntico ao nome dele no painel Cloudflare.
  "name": "vertrauem-contingencia",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Manutenção programada: "true" suspende o site e exibe src/manutencao.html.
  // Volte para "false" ao concluir a manutenção.
  "vars": {
    "MODO_MANUTENCAO": "false"
  },
  // O HTML é carregado como texto no próprio Worker, sem depender da VPS.
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": true
    }
  ]
  // Rotas intencionalmente gerenciadas pelo painel Cloudflare.
  // Não use Custom Domain: adicione uma Worker Route ao domínio da origem.
}
